{
  "$defs": {
    "CompositionAxis": {
      "additionalProperties": false,
      "description": "A per-axis length in canvas px (`x` = horizontal, `y` = vertical).",
      "properties": {
        "x": {
          "maximum": 800,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 450,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CompositionAxis",
      "type": "object"
    },
    "CompositionBorder": {
      "additionalProperties": false,
      "properties": {
        "bevel": {
          "default": false,
          "title": "Bevel",
          "type": "boolean"
        },
        "color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "width": {
          "maximum": 200,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width"
      ],
      "title": "CompositionBorder",
      "type": "object"
    },
    "CompositionGutter": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 400,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 400,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CompositionGutter",
      "type": "object"
    }
  },
  "$id": "https://frame-it/schemas/layout.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A saved layout: the `composition` block minus what belongs to one artwork.\n\nThe caption's *text* and `detached` are artwork state, so a layout carries only the side the\ncaption sits on. Everything else is exactly the block the Simple editor edits.",
  "properties": {
    "balance": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Balance"
    },
    "border": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompositionBorder"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "caption_align": {
      "default": "center",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "title": "Caption Align",
      "type": "string"
    },
    "caption_place": {
      "default": "none",
      "enum": [
        "none",
        "above",
        "below"
      ],
      "title": "Caption Place",
      "type": "string"
    },
    "cell_formats": {
      "items": {
        "anyOf": [
          {
            "pattern": "^(original|[1-9][0-9]{0,3}:[1-9][0-9]{0,3})$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 32,
      "title": "Cell Formats",
      "type": "array"
    },
    "format": {
      "default": "fill",
      "pattern": "^(fill|original|[1-9][0-9]{0,3}:[1-9][0-9]{0,3})$",
      "title": "Format",
      "type": "string"
    },
    "gutter": {
      "$ref": "#/$defs/CompositionGutter"
    },
    "outer": {
      "$ref": "#/$defs/CompositionAxis"
    },
    "recipe": {
      "pattern": "^[a-z0-9-]{1,64}$",
      "title": "Recipe",
      "type": "string"
    },
    "weights": {
      "items": {
        "anyOf": [
          {
            "items": {
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "type": "number"
            },
            "maxItems": 8,
            "minItems": 2,
            "type": "array"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 16,
      "title": "Weights",
      "type": "array"
    }
  },
  "required": [
    "recipe"
  ],
  "title": "Layout document v1",
  "type": "object"
}
