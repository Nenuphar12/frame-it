{
  "$id": "https://the-frame-v2/schemas/archive/tag_category.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A group of tags (People, Events\u2026). Absent from archives written before categories: a\nreader treats a missing `tag_categories.jsonl` as empty.",
  "properties": {
    "color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Color"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "position": {
      "default": 0.0,
      "title": "Position",
      "type": "number"
    }
  },
  "required": [
    "id",
    "name",
    "created_at"
  ],
  "title": "Archive tag_category record v1",
  "type": "object"
}
