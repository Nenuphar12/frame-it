{
  "$id": "https://the-frame-v2/schemas/archive/artwork.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deleted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deleted At"
    },
    "document": {
      "additionalProperties": true,
      "title": "Document",
      "type": "object"
    },
    "document_version": {
      "default": 1,
      "title": "Document Version",
      "type": "integer"
    },
    "favorite": {
      "default": false,
      "title": "Favorite",
      "type": "boolean"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "origin_layout_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Layout Id"
    },
    "origin_layout_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Layout Revision"
    },
    "origin_style_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Style Id"
    },
    "origin_style_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Style Revision"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "draft",
      "title": "Status",
      "type": "string"
    },
    "title": {
      "default": "",
      "title": "Title",
      "type": "string"
    },
    "trash_batch_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trash Batch Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "document",
    "created_at",
    "updated_at"
  ],
  "title": "Archive artwork record v1",
  "type": "object"
}
