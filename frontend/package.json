{
  "name": "frame-it-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src",
    "gen-api": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "conformance": "node scripts/conformance.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hash-wasm": "^4.13.0",
    "i18next": "^27.1.3",
    "immer": "^11.2.10",
    "konva": "^10.9.1",
    "lucide-react": "^1.73.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-konva": "^19.3.2",
